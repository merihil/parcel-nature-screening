POSTGRES_DB=naturedb
POSTGRES_USER=nature
POSTGRES_PASSWORD=nature
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# National Land Survey of Finland (MML) API key.
# Request one at https://asiointi.maanmittauslaitos.fi/
MML_API_KEY=your_mml_api_key_here

# SYKE Natura 2000 WFS
SYKE_NATURA_WFS_URL=https://your-syke-wfs-endpoint
SYKE_NATURA_SCI_TYPENAME=your_sci_typename
SYKE_NATURA_SPA_TYPENAME=your_spa_typename
SYKE_NATURA_SAC_TYPENAME=your_sac_typename

# Finnish Forest Centre (Metsäkeskus) forest stand WFS
FOREST_STAND_WFS=https://your-forest-stand-wfs-endpoint
FOREST_STAND_TYPENAME=v1:stand
