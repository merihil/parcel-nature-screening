POSTGRES_DB=naturedb
POSTGRES_USER=nature
POSTGRES_PASSWORD=nature
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# National Land Survey of Finland (MML) API key.
# Request one at https://asiointi.maanmittauslaitos.fi/
MML_API_KEY=your_mml_api_key_here

# The WFS endpoints of this project
# are public and default to the real values in config.py. These are in case
# they need to be overridden (e.g. a source moves, or for testing).
# SYKE_NATURA_WFS_URL=
# FOREST_STAND_WFS=
# SPECIAL_HABITAT_WFS=
